<?xml version="1.0" encoding="utf-8"?>
<!-- Centered fallback for tiny cells: station stack on top, transport keys in
    a centered row below. Same view IDs as widget_kleeamp (minus the seek row,
    which has no room here) so one code path tints and wires both layouts. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/w_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_bg_root" />

    <LinearLayout
        android:id="@+id/w_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/w_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:gravity="center"
            android:maxLines="1"
            android:singleLine="true"
            android:text="nothing tuned"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:gravity="center"
            android:maxLines="1"
            android:singleLine="true"
            android:text="pick a station"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/w_prev"
                android:layout_width="38dp"
                android:layout_height="38dp">

                <ImageView
                    android:id="@+id/w_prev_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_bg_key" />

                <ImageView
                    android:id="@+id/w_prev_icon"
                    android:layout_width="19dp"
                    android:layout_height="15dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_w_prev" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/w_toggle"
                android:layout_width="52dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp">

                <ImageView
                    android:id="@+id/w_toggle_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_bg_key" />

                <ImageView
                    android:id="@+id/w_toggle_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_w_play" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/w_next"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp">

                <ImageView
                    android:id="@+id/w_next_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_bg_key" />

                <ImageView
                    android:id="@+id/w_next_icon"
                    android:layout_width="19dp"
                    android:layout_height="15dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_w_next" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
