<?xml version="1.0" encoding="utf-8"?>
<!-- Icon-only fallback for a search widget shrunk to one cell: the glyph
    centered, same view IDs as widget_search so one code path tints and wires
    both layouts. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/s_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_bg_root" />

    <LinearLayout
        android:id="@+id/s_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/s_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_w_search" />
    </LinearLayout>
</FrameLayout>
