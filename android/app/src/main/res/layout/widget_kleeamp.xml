<?xml version="1.0" encoding="utf-8"?>
<!-- Classic RemoteViews twin of the old Glance WidgetBody: station title and
    subtitle left, prev / play-pause / next keys right. Every colour is applied
    at runtime from the palette (white vectors + white key/root shapes tinted
    via setColorFilter), so one layout wears all twenty-seven themes.
    RemoteViews only: FrameLayout / LinearLayout / TextView / ImageView. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/w_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_bg_root" />

    <LinearLayout
        android:id="@+id/w_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/w_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:singleLine="true"
                android:text="nothing tuned"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:singleLine="true"
                android:text="pick a station"
                android:textSize="11sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/w_prev"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="10dp">

            <ImageView
                android:id="@+id/w_prev_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_bg_key" />

            <ImageView
                android:id="@+id/w_prev_icon"
                android:layout_width="19dp"
                android:layout_height="15dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_w_prev" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/w_toggle"
            android:layout_width="52dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp">

            <ImageView
                android:id="@+id/w_toggle_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_bg_key" />

            <ImageView
                android:id="@+id/w_toggle_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_w_play" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/w_next"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp">

            <ImageView
                android:id="@+id/w_next_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_bg_key" />

            <ImageView
                android:id="@+id/w_next_icon"
                android:layout_width="19dp"
                android:layout_height="15dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_w_next" />
        </FrameLayout>
    </LinearLayout>

        <!-- Live brick scope: a bitmap painted twice a second from the real
            FFT, same bottom-anchored bricks as BrickMeter. RemoteViews cannot
            animate, so this is the flipbook version. Weighted to drink the
            leftover height between the transport row above and the seek row
            below, full-bleed edge to edge - collapsing to nothing in a short
            cell, and capped here so an oversized cell only adds empty margin
            instead of growing the content past the 226dp max. -->
        <ImageView
            android:id="@+id/w_scope"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:adjustViewBounds="true"
            android:maxHeight="120dp"
            android:minHeight="0dp"
            android:scaleType="fitXY"
            android:visibility="gone" />

        <!-- Live position for seekable sources (local files, provider tracks,
            episodes): elapsed, progress, remaining - the widget twin of the
            expanded player's scrubber row. Tapping it opens the app, where the
            real scrubber lives: RemoteViews has no draggable SeekBar, so a
            widget can show progress but never scrub it. Hidden for live
            radio, which gets the streaming rule instead. -->
        <LinearLayout
            android:id="@+id/w_seek_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/w_elapsed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="none"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:singleLine="true"
                android:text="0:00"
                android:textSize="11sp" />

            <ProgressBar
                android:id="@+id/w_seekbar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:max="100"
                android:maxHeight="4dp"
                android:minHeight="4dp"
                android:progress="0"
                android:progressBackgroundTint="@color/ink_tertiary"
                android:progressTint="@color/accent" />

            <TextView
                android:id="@+id/w_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="none"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:singleLine="true"
                android:text="-0:00"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/w_streaming"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="none"
            android:fontFamily="monospace"
            android:gravity="center"
            android:letterSpacing="0.16"
            android:maxLines="1"
            android:singleLine="true"
            android:text="--- STREAMING ---"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
