<?xml version="1.0" encoding="utf-8"?>
<!-- Min-height tier (one-row cells): the full row's fixed chrome is ~106dp,
    so centering it in ~96dp nibbles the title's top and the toggle's
    bottom. This is the same transport row laid out to fit - titles left,
    prev / play-pause / next right - with the seek bar (or the streaming
    rule for live stations) underneath, exactly like the full layout.
    Same view IDs as the other two layouts (minus the scope, which one row
    has no room for) so one code path tints and wires all three. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/w_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_bg_root" />

    <LinearLayout
        android:id="@+id/w_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/w_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="nothing tuned"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/w_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="pick a station"
                    android:textSize="11sp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/w_prev"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="10dp">

                <ImageView
                    android:id="@+id/w_prev_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_bg_key" />

                <ImageView
                    android:id="@+id/w_prev_icon"
                    android:layout_width="19dp"
                    android:layout_height="15dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_w_prev" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/w_toggle"
                android:layout_width="52dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp">

                <ImageView
                    android:id="@+id/w_toggle_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_bg_key" />

                <ImageView
                    android:id="@+id/w_toggle_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_w_play" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/w_next"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp">

                <ImageView
                    android:id="@+id/w_next_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_bg_key" />

                <ImageView
                    android:id="@+id/w_next_icon"
                    android:layout_width="19dp"
                    android:layout_height="15dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_w_next" />
            </FrameLayout>
        </LinearLayout>

        <!-- Live position for seekable sources, like the full layout's
            scrubber readout. RemoteViews cannot drag it; it only displays. -->
        <LinearLayout
            android:id="@+id/w_seek_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/w_elapsed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="none"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:singleLine="true"
                android:text="0:00"
                android:textSize="11sp" />

            <ProgressBar
                android:id="@+id/w_seekbar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:max="100"
                android:maxHeight="4dp"
                android:minHeight="4dp"
                android:progress="0"
                android:progressBackgroundTint="@color/ink_tertiary"
                android:progressTint="@color/accent" />

            <TextView
                android:id="@+id/w_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="none"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:singleLine="true"
                android:text="-0:00"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/w_streaming"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="none"
            android:fontFamily="monospace"
            android:gravity="center"
            android:letterSpacing="0.16"
            android:maxLines="1"
            android:singleLine="true"
            android:text="--- STREAMING ---"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
