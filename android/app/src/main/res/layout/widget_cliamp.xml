<?xml version="1.0" encoding="utf-8"?>
<!-- Classic RemoteViews twin of the old Glance WidgetBody: station title and
    subtitle left, prev / play-pause / next keys right. Every colour is applied
    at runtime from the palette (white vectors + white key/root shapes tinted
    via setColorFilter), so one layout wears all twenty-seven themes.
    RemoteViews only: FrameLayout / LinearLayout / TextView / ImageView. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/w_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_bg_root" />

    <LinearLayout
        android:id="@+id/w_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/w_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:singleLine="true"
                android:text="nothing tuned"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:singleLine="true"
                android:text="pick a station"
                android:textSize="11sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/w_prev"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="10dp">

            <ImageView
                android:id="@+id/w_prev_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_bg_key" />

            <ImageView
                android:id="@+id/w_prev_icon"
                android:layout_width="19dp"
                android:layout_height="15dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_w_prev" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/w_toggle"
            android:layout_width="52dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp">

            <ImageView
                android:id="@+id/w_toggle_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_bg_key" />

            <ImageView
                android:id="@+id/w_toggle_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_w_play" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/w_next"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp">

            <ImageView
                android:id="@+id/w_next_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_bg_key" />

            <ImageView
                android:id="@+id/w_next_icon"
                android:layout_width="19dp"
                android:layout_height="15dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_w_next" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
